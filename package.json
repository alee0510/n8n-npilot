{
	"name": "n8n-nodes-npilot",
	"version": "0.1.4",
	"description": "Session-based browser automation node for n8n. Automate web interactions, extract data, and take screenshots using a Playwright-powered Chromium RPA engine.",
	"license": "MIT",
	"homepage": "",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"automation",
		"rpa",
		"browser-automation",
		"web-scraping",
		"playwright",
		"chromium",
		"scraper",
		"screenshot",
		"workflow"
	],
	"author": {
		"name": "Ali Muksin",
		"email": "ali.muksin0510@gmail.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/alee0510/n8n-npilot"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev --external-n8n",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"cleanup": "pkill -f 'ms-playwright.*chromium' || true"
	},
	"files": [
		"dist/**/*.js",
		"dist/**/*.d.ts",
		"dist/**/*.json",
		"dist/**/*.svg"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [],
		"nodes": [
			"dist/nodes/npilot/Npilot.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.23.1",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"dependencies": {
		"playwright": "^1.59.1"
	}
}
